{
    "name": "@elgato/mcp-server",
    "version": "0.1.5",
    "description": "A Model Context Protocol (MCP) server that bridges AI assistants with Elgato apps.",
    "type": "module",
    "bin": {
        "elgato-mcp-server": "bin/index.js"
    },
    "exports": {
        "./package.json": "./package.json"
    },
    "files": [
        "bin/",
        "assets/"
    ],
    "scripts": {
        "build": "tsc",
        "lint": "eslint --max-warnings 0",
        "lint:fix": "prettier . --write",
        "start": "node bin/index.js",
        "http": "node bin/index.js --http",
        "ngrok": "node bin/index.js --http --ngrok",
        "mcpb": "scripts/pack_mcpb.sh $npm_package_version",
        "bundle:mcpb": "node scripts/bundle_mcpb.mjs",
        "test": "vitest run",
        "test:unit": "vitest run src/__tests__/unit",
        "test:integration": "vitest run src/__tests__/integration",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:ci": "vitest run --coverage",
        "dev_check": "pnpm build && pnpm lint && pnpm test"
    },
    "author": {
        "name": "Elgato",
        "url": "https://www.elgato.com"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/elgatosf/elgato-mcp-server.git"
    },
    "bugs": {
        "url": "https://github.com/elgatosf/elgato-mcp-server/issues"
    },
    "homepage": "https://github.com/elgatosf/elgato-mcp-server#readme",
    "license": "MIT",
    "packageManager": "pnpm@11.23.0",
    "prettier": "@elgato/prettier-config",
    "engines": {
        "node": ">=18.0.0"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.30.0",
        "@ngrok/ngrok": "^1.7.0",
        "cors": "^2.8.6",
        "express": "^5.2.1"
    },
    "devDependencies": {
        "@anthropic-ai/mcpb": "2.1.2",
        "@changesets/cli": "^2.31.1",
        "@elgato/eslint-config": "^0.3.2",
        "@elgato/prettier-config": "^0.3.3",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^25.9.5",
        "@vitest/coverage-v8": "^4.1.11",
        "esbuild": "0.28.2",
        "eslint": "^9.39.5",
        "prettier": "3.9.6",
        "typescript": "^5.9.3",
        "vitest": "^4.1.11"
    },
    "keywords": [
        "mcp",
        "model-context-protocol",
        "elgato",
        "stream-deck",
        "ai",
        "claude",
        "automation"
    ]
}
